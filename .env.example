# Optional settings. Copy the variables you need into your shell (or export them before ./start.sh).
# Nothing here is required: every value has a working default.

# ---- start script
BACKEND_PORT=8000
FRONTEND_PORT=3000
HOST=127.0.0.1                      # 0.0.0.0 shares the app on your network (then set NEXT_PUBLIC_API_URL below)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_ADMIN_KEY=            # sent as X-API-Key by the web app when the server has ADMIN_API_KEY

# ---- backend
# ADMIN_API_KEY=                    # require X-API-Key for create / edit / delete / capture calls
# FORCE_CPU=1                       # never use CUDA
# TTA=0                             # disable flip test-time augmentation (faster, slightly less accurate)
# DEMO_FALLBACK=0                   # return errors instead of demo answers when a model is unavailable
# RISK_WARN=100                     # default Warning / Critical thresholds for image analysis (people)
# RISK_CRIT=200
# CAMERA_POLLING=0                  # do not run the background camera poller
# STALE_MINUTES=15                  # a camera without a reading this long counts as offline
# ALLOW_FILE_CAMERAS=1              # allow "file" camera sources (demos only)
# CROWD_DB=/path/to/crowd.db        # SQLite location (default backend/data/crowd.db)
# DEMO_IMAGES_DIR=/path/to/ShanghaiTech/part_B/test_data/images   # only for the demo camera feed
